{
  "expo": {
    "name": "Derso",
    "slug": "derso",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.dersomatik.app",
      "config": {
        "usesNonExemptEncryption": false
      },
      "buildNumber": "1",
      "appleTeamId": "64LAYF4GNP"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.dersomatik.app",
      "versionCode": 4
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#FFFFFF",
          "imageWidth": 160,
          "resizeMode": "contain"
        }
      ],
      "expo-font",
      "./plugins/with-release-signing"
    ],
    "scheme": "derso",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      }
    }
  }
}
