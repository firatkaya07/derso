# Supabase proje ayarlarındaki "Project URL" ve "anon public" anahtarı.
# Supabase panelinde: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://proje-kimliginiz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Üretim site adresi (canonical, sitemap, Open Graph). Sonda / olmasın.
NEXT_PUBLIC_SITE_URL=https://dersomatik.com

# Google Analytics 4 — Measurement ID (G-XXXXXXXXXX).
# Boş bırakılırsa GA yüklenmez.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console — doğrulama meta tag'inin content değeri.
# Boş bırakılırsa meta tag eklenmez.
NEXT_PUBLIC_GSC_VERIFICATION=
